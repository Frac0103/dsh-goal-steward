{
  "name": "dsh-goal-steward",
  "version": "0.2.0-alpha.1",
  "description": "Independent goal governance for DeepSeek Harness: a standing goal charter plus a role-isolated reviewer that audits goal drift at turn boundaries, without micromanaging the executor.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "goal",
    "goal-drift",
    "alignment",
    "reviewer",
    "governance",
    "management"
  ],
  "author": "Jiahao Ma <1780887202@qq.com>",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "docs:theory": "node scripts/theory-doc.mjs",
    "verify": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frac0103/dsh-goal-steward.git"
  },
  "bugs": {
    "url": "https://github.com/Frac0103/dsh-goal-steward/issues"
  },
  "homepage": "https://github.com/Frac0103/dsh-goal-steward#readme",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2"
  }
}
